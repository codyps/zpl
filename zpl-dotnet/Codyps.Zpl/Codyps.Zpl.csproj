<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0;net472</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Version>0.3.2</Version>
    <PackageId>Codyps.Zpl</PackageId>
    <Authors>Cody P Schafer</Authors>
    <Description>Local ZPL parsing and rendering to PNG, SVG, PDF and grayscale, powered by the Rust zpl renderer.</Description>
    <PackageTags>Zebra;ZPL;ZPL2;Label;Thermal;Barcode;ZPLParser;ZPLViewer;ZPLConverter;ZPLEmulator;ZPL2PNG;ZPL2PDF;ZPL2Image;ZPLtoPNG;ZPLtoPDF;ZPLtoImage;PNG;PDF;SVG</PackageTags>
    <PackageLicenseExpression>OSL-3.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/codyps/zpl</RepositoryUrl>
    <PackageProjectUrl>https://github.com/codyps/zpl</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NativeRoot Condition="'$(NativeRoot)' == ''">$(MSBuildThisFileDirectory)../native</NativeRoot>
    <!-- Modern targets follow Microsoft's native package layout. Framework
         uses lib/net472 plus the packaged native-copy targets instead.
         https://learn.microsoft.com/en-us/nuget/create-packages/native-files-in-net-packages -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackManagedAssets</TargetsForTfmSpecificContentInPackage>
    <!-- NU5131 expects lib/ assemblies for every dependency group. Modern
         targets deliberately use ref/ and runtimes/; packages.config uses net472.
         https://github.com/NuGet/Home/discussions/11097 -->
    <NoWarn>$(NoWarn);NU5131</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0'">
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="$(NativeRoot)/**/*" Pack="true" PackagePath="runtimes/" />
    <None Include="../build/Codyps.Zpl.targets" Pack="true" PackagePath="build/;buildTransitive/" />
  </ItemGroup>
  <!-- Pack extension documented at
       https://learn.microsoft.com/en-us/nuget/reference/msbuild-targets#advanced-extension-points-to-create-customized-package -->
  <Target Name="PackManagedAssets" DependsOnTargets="BuiltProjectOutputGroup">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="ref/$(TargetFramework)/" />
      <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="runtimes/any/lib/$(TargetFramework)/" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
      <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="lib/net472/" />
    </ItemGroup>
  </Target>
</Project>
